#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

if [[ ! -d "${PWD}/config" ]]; then
    mkdir -p "${PWD}/config"
    hass --config "${PWD}/config" --script ensure_config
fi

# Keep runtime-installed Home Assistant requirements importable immediately,
# including on the first launch of a freshly built development container.
USER_SITE="$(python3 -c 'import site; print(site.getusersitepackages())')"
mkdir -p "${USER_SITE}"

# Home Assistant imports custom integrations through the top-level
# custom_components package. Put the repository root on PYTHONPATH so
# custom_components/weather_platform is discoverable by the running HA process.
export PYTHONPATH="${USER_SITE}:${PWD}${PYTHONPATH:+:${PYTHONPATH}}"

hass --config "${PWD}/config" --debug
