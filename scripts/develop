#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

if [[ ! -d "${PWD}/config" ]]; then
    mkdir -p "${PWD}/config"
    hass --config "${PWD}/config" --script ensure_config
fi

# Keep runtime-installed Home Assistant requirements importable immediately,
# including on the first launch of a freshly built development container.
USER_SITE="$(python3 -c 'import site; print(site.getusersitepackages())')"
mkdir -p "${USER_SITE}"
export PYTHONPATH="${USER_SITE}:${PWD}/custom_components${PYTHONPATH:+:${PYTHONPATH}}"

hass --config "${PWD}/config" --debug
